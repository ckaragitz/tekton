# --- environments / caches ---
.venv/
__pycache__/
*.pyc
*.egg-info/
.DS_Store
scratch/
node_modules/

# --- third-party / Autodesk-derived material: NEVER committed ---
samples/
vendor/
extracted/

# --- experiment probe BINARIES (dev-only, many embed sample-derived content;
#     5+ GB). The JSON/MD evidence records alongside them ARE committed. ---
experiments/**/*.rvt
experiments/**/*.rfa
experiments/**/*.bin
experiments/**/*.gz
experiments/roundtrip/
experiments/out/

# --- presenter cheat sheets: never pushed ---
ANSWER_KEY.md
DEMO_RUNBOOK.md
demo-talk-track.md

# --- sample-derived example binaries + parse caches ---
usecases/**/*.rvt
plugin/examples/**/*.rvt
**/.cache/
tests/out/

# --- build artifacts (regenerate: .venv/bin/python tools/sync_plugin.py) ---
/*.zip

# Agent-isolation worktrees created inside the checkout by multi-agent workflows (never commit)
.claude/worktrees/

# Job output written by every documented command (frontdoor --out out/..., benches, scout scratch) — never commit
out/

# ifc-assembly loadcrash probe: write-reports carry machine-absolute paths
experiments/ifc-assembly/loadcrash/*.report.json
experiments/ifc-assembly/arcsolver/*.report.json
experiments/ifc-assembly/rotate/*.report.json
